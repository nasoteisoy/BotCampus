{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bot-campus.local/campus-state.schema.json",
  "title": "Bot Campus live state",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "jesusDeskId",
    "desks",
    "bots",
    "deploys"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "jesusDeskId": {
      "type": "string"
    },
    "desks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "ownerBotId": {
            "type": [
              "string",
              "null"
            ]
          },
          "zone": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "bots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deskId",
          "status",
          "task",
          "updatedAt",
          "main",
          "interns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "deskId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "working",
              "ready_for_review",
              "needs_permission",
              "reviewing",
              "collaborating"
            ]
          },
          "task": {
            "type": "string",
            "description": "Short label for phone UI"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "main": {
            "type": "object",
            "required": [
              "status",
              "atDeskId"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "idle",
                  "working",
                  "ready_for_review",
                  "needs_permission",
                  "reviewing",
                  "collaborating"
                ]
              },
              "task": {
                "type": "string"
              },
              "atDeskId": {
                "type": "string"
              },
              "x": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "y": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stationId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "interns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "status",
                "atDeskId",
                "updatedAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "working",
                    "ready_for_review",
                    "needs_permission",
                    "reviewing",
                    "collaborating"
                  ]
                },
                "task": {
                  "type": "string"
                },
                "atDeskId": {
                  "type": "string"
                },
                "x": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "y": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "stationId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "castFolder": {
            "type": "string"
          },
          "sprites": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "personality": {
            "type": "object",
            "description": "Profile personality kit (Dev B NPC FSM)",
            "properties": {
              "vibe": {
                "type": "string"
              },
              "idle": {
                "type": "string"
              },
              "walk": {
                "type": "string",
                "enum": [
                  "saunter",
                  "hurry",
                  "measured"
                ]
              },
              "emotionBias": {
                "type": "string"
              },
              "accessory": {
                "type": "string"
              },
              "preferredStation": {
                "type": "string"
              },
              "speed": {
                "type": "number"
              },
              "fidgetRate": {
                "type": "number"
              }
            }
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "deploys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repo",
          "label",
          "status",
          "pagesUrl",
          "repoUrl",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "description": "owner/name"
          },
          "branch": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "building",
              "ready",
              "failed"
            ]
          },
          "pagesUrl": {
            "type": "string"
          },
          "repoUrl": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string"
          },
          "checkUrl": {
            "type": "string",
            "description": "Alias of repoUrl for UI convenience"
          }
        }
      }
    },
    "stations": {
      "type": "array",
      "description": "Map workstations NPCs path to when busy",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "art",
              "research",
              "permission"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "zone": {
            "type": "string"
          }
        }
      }
    },
    "world": {
      "type": "object",
      "properties": {
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "castFiles": {
      "type": "object"
    }
  }
}
